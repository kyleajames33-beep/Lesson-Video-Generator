{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["react", "react-dom"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["./*.ts", "./*.tsx"]
}
