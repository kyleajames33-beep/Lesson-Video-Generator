        },
        {
          "text": "scale",
          "start": 24.763000000000066,
          "end": 25.01466666666673
        },
        {
          "text": "place",
          "start": 31.346000000000043,
          "end": 31.56350000000004
        }
      ],
      "seconds": 31.868,
      "peakFraction": 0.902008056640625,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "each",
          "start": 10.45999999999999,
