        }
      ],
      "seconds": 42.84,
      "peakFraction": 0.868194580078125,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 147,
      "outputTokens": 1071,
      "costUsd": 0.0097125,
      "pronunciationText": "Now a region below the axis. Take y equals x squared minus four, from zero to two. On this stretch the curve is under the axis, so every height is negative, and every strip adds a negative amount. A primitive is x cubed over three, minus four x. At two that's eight thirds minus eight, which is minus sixteen thirds, and at zero it's zero. So the integral is minus sixteen thirds. But an area can't be negative. A strip's area uses its length, and here the length is minus the height. So the area is the integral with its sign removed, sixteen thirds. We write it as the absolute value of the integral, or as minus the integral."
    },
    {
      "id": "scene-04",
      "changed": true,
      "audio": "public/audio/math-a12-i10/scene-04.wav",
      "durationInFrames": 1179,
      "worstWordGap": {
