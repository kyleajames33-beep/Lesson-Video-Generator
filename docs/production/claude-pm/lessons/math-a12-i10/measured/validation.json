      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 100,
      "outputTokens": 806,
      "costUsd": 0.007304,
      "pronunciationText": "Start with the easy case. When the curve stays on or above the axis, every strip has a positive height, so every strip adds area. Then the area and the integral are the same number. Take y equals two x plus one, from one to three. Earlier, we found this trapezium's area, ten, by geometry. Now with a primitive, x squared plus x, it's twelve minus two, which is ten. Same number, because nothing is below the axis."
    },
    {
      "id": "scene-03",
      "changed": true,
      "audio": "public/audio/math-a12-i10/scene-03.wav",
      "durationInFrames": 1286,
      "worstWordGap": {
        "seconds": 0.864999999999986,
        "after": "two.",
        "before": "On"
      },
      "cues": [
        {
          "text": "thirds",
          "start": 18.671000000000053,
          "end": 18.97200000000005
        },
        {
          "text": "integral",
