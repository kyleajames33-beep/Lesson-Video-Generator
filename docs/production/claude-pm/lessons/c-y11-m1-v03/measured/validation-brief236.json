      },
      "peakFraction": 0.840484619140625,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "a",
          "start": 14.571999999999997,
          "end": 14.631999999999998,
          "score": 0.314
        }
      ],
      "requestAttempts": 0,
      "pronunciationText": "Notice the order. Filter first, then crystallise the filtrate. Crystallise first, and the sand ends up buried in your salt crystals. Undissolved, filter it out. Dissolved, crystallise it out. Filter paper works a bit like a kitchen sieve, where big pieces stay and small ones pass through. But dissolved salt isn't tiny grains of salt. It's separate ions, so filter paper cannot catch it.",
      "humanListening": "pending"
    },
