      },
      "cues": [
        {
          "text": "seconds",
          "start": 46.03199999999997,
          "end": 46.31374999999996
        },
        {
          "text": "integral",
          "start": 50.58699999999983,
          "end": 50.89011111111095
        }
      ],
      "seconds": 51.289,
      "peakFraction": 0.8231201171875,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "read",
          "start": 1.144,
          "end": 1.384,
          "score": 0.485
        },
        {
          "word": "integral",
          "start": 12.34899999999999,
