      "possibleRetry": false,
      "inputTokens": 45,
      "outputTokens": 311,
      "costUsd": 0.0028215,
      "pronunciationText": "Here's a way to keep them apart. The mode is the top of f. The median and quartiles go across from F. For the median, go across from one half, and down to the axis."
    },
