      "voiceover": {
        "text": "Here's a way to remember the split ring's job. Every half turn, flip the current. Flip the current, and the forces flip, so the torque keeps turning the same way."
      },
      "durationInFrames": 1,
      "holdSeconds": 2,
      "holdKind": "visual"
    },
