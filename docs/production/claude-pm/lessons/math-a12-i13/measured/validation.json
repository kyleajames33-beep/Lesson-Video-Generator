      ],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 138,
      "outputTokens": 991,
      "costUsd": 0.008988,
      "pronunciationText": "So the energy is the integral from zero to twelve, of four sine of pi t over twelve. The inside is linear, with rate pi over twelve, so the primitive divides by it. That gives minus forty-eight over pi, times cos of pi t over twelve. At twelve, cos pi is minus one. At zero, cos zero is one. So the energy is ninety-six over pi, about thirty point six kilowatt hours. That's less than forty-eight, as predicted. Notice the domain, too. After eight at night this formula goes negative, but an air conditioner can't use negative power. So the model only holds from zero to twelve."
    },
    {
      "id": "scene-04",
      "changed": true,
      "audio": "public/audio/math-a12-i13/scene-04.wav",
      "durationInFrames": 1340,
      "worstWordGap": {
