        }
      ],
      "seconds": 34.2,
      "peakFraction": 0.91650390625,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "write",
          "start": 8.484999999999989,
