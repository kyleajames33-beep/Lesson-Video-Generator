          "end": 29.152800000000088
        }
      ],
      "seconds": 36.88,
      "peakFraction": 0.836273193359375,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "v",
          "start": 30.551000000000077,
          "end": 30.571000000000076,
          "score": 0
        }
      ],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 0,
      "possibleRetry": false,
      "inputTokens": 126,
      "outputTokens": 923,
      "costUsd": 0.00837,
      "pronunciationText": "Let's find out. Displacement is position measured from the starting point, and it's negative on the left. Velocity is how fast displacement changes, so it's the gradient of the displacement graph: v equals d x by d t. Differentiate, and v is three t squared minus eighteen t plus twenty-four, which factors to three, t minus two, t minus four. So the robot is at rest at two seconds and at four seconds, where the graph is flat. In between, v is negative, and the robot moves left. Speed is the size of the velocity, without its sign."
    },
    {
      "id": "scene-03",
      "changed": true,
      "audio": "public/audio/math-a12-i14/scene-03.wav",
      "durationInFrames": 1026,
      "worstWordGap": {
