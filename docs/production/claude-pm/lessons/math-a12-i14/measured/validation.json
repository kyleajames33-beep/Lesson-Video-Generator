      "costUsd": 0.0067405,
      "pronunciationText": "Last video ended here, with a robot vacuum at one end of a hallway. Its displacement, x centimetres from where it starts, is t cubed minus nine t squared plus twenty-four t, after t seconds. Watch it move. It heads along the hallway, stops, backs up a little, stops again, then speeds off. At two and a half seconds, its acceleration turns out to be negative. So is it slowing down?"
    },
    {
      "id": "scene-02",
      "changed": true,
      "audio": "public/audio/math-a12-i14/scene-02.wav",
      "durationInFrames": 1107,
      "worstWordGap": {
        "seconds": 0.9039999999998116,
        "after": "left.",
        "before": "Speed"
      },
      "cues": [
        {
          "text": "four",
          "start": 19.880999999999993,
          "end": 20.060999999999993
        },
        {
          "text": "flat",
