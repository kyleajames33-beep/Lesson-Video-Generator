        {
          "word": "a",
          "start": 1.306,
          "end": 1.326,
          "score": 0.295
        }
      ],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 131,
      "outputTokens": 911,
      "costUsd": 0.0082645,
      "pronunciationText": "Here's the reason, with a small case. Take two minus one, times one plus two plus four plus eight. Two minus one is just one, so this is the sum itself. Now expand the brackets. Two times the bracket gives two, four, eight and sixteen. On the board, doubling every pile gives the next square's pile, so the whole row slides one square along. Minus one times the bracket gives minus one, minus two, minus four and minus eight. Line them up, and the middle terms cancel in pairs. Only two terms survive: sixteen, and minus one. So the sum is sixteen minus one."
    },
    {
      "id": "scene-03",
      "changed": true,
      "audio": "public/audio/math-a12-f06/scene-03.wav",
      "durationInFrames": 1130,
      "worstWordGap": {
        "seconds": 0.8429999999999502,
        "after": "one.",
        "before": "Nothing"
      },
      "cues": [
        {
          "text": "n",
          "start": 1.3194000000000001,
