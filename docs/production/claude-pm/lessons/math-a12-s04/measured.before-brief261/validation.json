      ],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 89,
      "outputTokens": 615,
      "costUsd": 0.0055795,
      "pronunciationText": "What about a time under zero point two five seconds? That cuts the second class in half, and the histogram doesn't say where its fifty times sit. The usual assumption is that they're spread evenly. Then about twenty five are below zero point two five. Add the twenty from the first class, and that's forty five out of two hundred, zero point two two five. In an exam, write that assumption down."
    },
    {
      "id": "scene-05",
      "changed": true,
      "audio": "public/audio/math-a12-s04/scene-05.wav",
      "durationInFrames": 1031,
      "worstWordGap": {
