      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 112,
      "outputTokens": 859,
      "costUsd": 0.007787,
      "pronunciationText": "The class from zero point three to zero point four has probability about zero point three five. Shrink it to one hundredth of a second, centred on zero point three five. With the times spread evenly, it holds a tenth as many, so about zero point zero three five. Shrink it to one thousandth, and it's about zero point zero zero three five. Under that even spread, the probability shrinks in step with the width. A single exact value has width zero, so for a continuous random variable, its probability is zero."
    },
    {
      "id": "scene-06",
      "changed": true,
      "audio": "public/audio/math-a12-s04/scene-06.wav",
      "durationInFrames": 612,
      "worstWordGap": {
