      "peakFraction": 0.9202880859375,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 66,
      "outputTokens": 510,
      "costUsd": 0.004623,
      "pronunciationText": "But someone's time really is zero point three five something. Probability zero isn't the same as impossible. Some exact time always happens, but no single value carries any probability on its own. Intervals do, like zero point three four to zero point three six seconds, and those are the events we'll use."
    },
    {
      "id": "scene-07",
      "changed": true,
      "audio": "public/audio/math-a12-s04/scene-07.wav",
      "durationInFrames": 617,
      "worstWordGap": {
        "seconds": 0.621999999999991,
        "after": "difference.",
        "before": "That's"
      },
      "cues": [
        {
          "text": "difference",
          "start": 7.173999999999995,
          "end": 7.4839999999999955
        },
        {
          "text": "each",
          "start": 19.795000000000066,
          "end": 20.085400000000064
        }
      ],
      "seconds": 20.56,
      "peakFraction": 0.833709716796875,
      "fullScaleSamples": 0,
      "silencesAtLeast1_5s": [],
      "lowScoreWords": [
        {
          "word": "a",
          "start": 19.393000000000065,
          "end": 19.453000000000063,
          "score": 0.434
