      ],
      "successfulRequestCount": 1,
      "loggedRequestAttempts": 1,
      "possibleRetry": false,
      "inputTokens": 71,
      "outputTokens": 514,
      "costUsd": 0.0046615,
      "pronunciationText": "The ends of an interval are single values, so they carry no probability. So including or excluding the ends makes no difference. That's not true for a discrete variable. For a fair die, two to five including both ends has probability four sixths, but strictly between them it's two sixths. The ends carry a sixth each."
    },
    {
      "id": "scene-08",
      "changed": true,
      "audio": "public/audio/math-a12-s04/scene-08.wav",
      "durationInFrames": 1206,
      "worstWordGap": {
        "seconds": 0.9020000000000188,
        "after": "one.",
        "before": "Now"
      },
      "cues": [
        {
          "text": "one",
          "start": 2.814,
          "end": 2.955
        },
        {
          "text": "before",
          "start": 39.53799999999992,
