      "possibleRetry": false,
      "inputTokens": 123,
      "outputTokens": 893,
      "costUsd": 0.008098500000000002,
      "pronunciationText": "The smooth bell that fits this shape is called the normal distribution. It's a continuous probability distribution, and it's used to model many naturally occurring things, like adult heights in one population, measurement errors, and products from a machine. A bag can have any mass, not just ay whole number of grams, so the model is a smooth curve, not bars. Just as in the histogram, the area over an interval is the probability. The fit is never perfect. It's a model, worth trying when the data bunch symmetrically around one peak, and then the tails have to match too."
    },
    {
      "id": "scene-04",
      "changed": true,
      "audio": "public/audio/math-a12-s09/scene-04.wav",
      "durationInFrames": 1138,
      "worstWordGap": {
