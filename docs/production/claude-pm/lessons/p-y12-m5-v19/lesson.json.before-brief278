      }
    },
    {
      "id": "feedback-1",
      "title": "feedback 1 (brief)",
      "voiceover": {
        "text": "Convert the period to seconds: four point three two times ten to the four. Then r cubed equals big G M T squared over four pi squared, and the cube root gives r of about two point six six times ten to the seven metres. Subtract Earth's radius, and the altitude is about two point zero three times ten to the seven metres. The classic slip is stopping at r, which is measured from the centre, not the surface."
      },
      "durationInFrames": 1,
      "holdSeconds": 1,
      "holdKind": "visual"
    },
    {
      "id": "attempt-2",
      "title": "attempt 2 (countdown, 10 seconds)",
      "voiceover": {
        "text": "Last one. A satellite has a circular orbit with a period of twenty-four hours, but its orbit is tilted at thirty degrees to the equator. Explain why it is not geostationary. Pause here to answer."
      },
      "durationInFrames": 1,
      "holdSeconds": 10,
      "holdKind": "countdown",
      "planningResponseInterval": {
        "countdownSeconds": 10
