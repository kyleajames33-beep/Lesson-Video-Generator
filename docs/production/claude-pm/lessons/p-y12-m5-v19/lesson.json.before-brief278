      "title": "attempt 1 (countdown, 10 seconds)",
      "voiceover": {
        "text": "Your turn. A navigation satellite moves in a circular orbit with a period of twelve point zero hours. Calculate its altitude above Earth's surface, using the data sheet values. Pause here to answer."
      },
      "durationInFrames": 1,
      "holdSeconds": 10,
      "holdKind": "countdown",
      "planningResponseInterval": {
